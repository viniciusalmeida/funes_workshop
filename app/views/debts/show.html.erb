<div class="py-4">
  <h1 class="text-5xl font-bold">Debt</h1>
</div>

<%= render "debts/details", debt_id: @debt_id, debt: @debt %>

<div class="mt-4 grid grid-cols-2 space-x-5">
  <%= turbo_frame_tag "new-payment", loading: "lazy", src: new_debt_payment_path(@debt_id) do %>
    <p class="text-sm text-gray-400 mt-4">Loading payment form...</p>
  <% end %>

  <fieldset class="border p-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    <legend>Events</legend>

    <ul id="events" class="space-y-3">
      <% @event_stream.events.each do |event| %>
        <%= render "debts/event", event: event %>
      <% end %>
    </ul>
  </fieldset>
</div>

<hr class="mt-8" />

<%= link_to "<- back to debts list", debts_path,
            class: "text-gray-400 uppercase mt-4 block underline underline-offset-2" %>
