<%# locals: (event:, highlight: false) %>

<li>
  <pre class="text-wrap border p-3 bg-gray-100 text-gray-500 border-gray-400 [&.highlighted]:bg-orange-400"
       data-controller="<%= "highlight" if highlight %>"><%= event.inspect %></pre>
  <p class="text-xs p-0.5 text-gray-400 bg-gray-50">
    <span class="font-black">Created at:</span> <%= event.created_at %>
  </p>
</li>
