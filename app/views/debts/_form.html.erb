<%= turbo_frame_tag event do %>
  <fieldset class="border p-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    <legend>New issuance</legend>

    <% if local_assigns[:notice] %>
      <div class="border-2 border-green-500 bg-green-50 p-4 mb-4 relative"
           data-controller="flash">
        <button data-action="click->flash#dismiss"
                class="text-green-700 text-sm font-normal -top-3 right-2 absolute bg-green-50 px-1
                       py-0.5 cursor-pointer">Close [X]</button>
        <p class="text-green-700 text-sm font-bold"><%= notice %></p>
      </div>
    <% end %>

    <% if event.errors.any? %>
      <div class="border-2 border-red-500 bg-red-50 p-4 mb-4">
        <ul>
          <% event.errors.full_messages.each do |msg| %>
            <li class="text-red-700 text-sm font-bold"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: event, url: debts_path, scope: :debt_issued do |f| %>
      <%= f.label :principal %>
      <%= f.number_field :principal, class: "mb-2 w-full border p-2 focus:outline-none focus:ring-2 focus:ring-black" %>

      <%= f.label :interest_rate %>
      <%= f.number_field :interest_rate, step: 0.01, min: 0, max: 1,
                         placeholder: "e.g. 0.1 for 10%",
                         class: "mb-2 w-full border p-2 focus:outline-none focus:ring-2 focus:ring-black" %>

      <%= f.label :interest_rate_base %>
      <div class="relative after:pointer-events-none after:absolute after:top-1/2 after:right-3 after:-translate-y-1/2
                after:text-xs after:content-['▼'] mb-2">
        <%= f.select :interest_rate_base, [ %w[Yearly yearly], %w[Monthly monthly], %w[Daily daily] ], {},
                     class: "w-full appearance-none border bg-white p-2 outline-none" %>
      </div>

      <%= f.label :at %>
      <%= f.date_field :at, class: "mb-2 w-full border p-2 focus:outline-none focus:ring-2 focus:ring-black
                                    text-black [&::-webkit-datetime-edit]:text-gray-400
                                    [&.has-value]:text-black [&.has-value::-webkit-datetime-edit]:text-black",
                       data: { controller: "date-field-state", action: "change->date-field-state#toggleStateClass" } %>

      <%= f.submit class: "my-5 border-2 border-black bg-gray-200 px-6 py-2 font-bold text-black
                           shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px]
                           hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]
                           active:translate-x-[4px] active:translate-y-[4px] active:shadow-none uppercase" %>
    <% end %>
  </fieldset>
<% end %>