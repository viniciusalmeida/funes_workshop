<%# locals: (notice:) %>

<div class="border-2 border-green-500 bg-green-50 p-4 mb-4 relative"
     data-controller="flash">
  <button data-action="click->flash#dismiss"
          class="text-green-700 text-sm font-normal -top-3 right-2 absolute bg-green-50 px-1
                 py-0.5 cursor-pointer">Close [X]</button>
  <p class="text-green-700 text-sm font-bold"><%= notice %></p>
</div>
